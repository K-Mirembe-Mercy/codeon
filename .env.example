# Anthropic Claude API Configuration
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# Claude Model Selection (defaults to claude-3-5-sonnet-latest if omitted)
# Recommended options: claude-3-5-sonnet-latest, claude-3-5-haiku-latest
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Allowed CORS Origin for deployment (default is https://codeondigital.com)
ALLOWED_ORIGIN=https://codeondigital.com

# WhatsApp Fallback Link / Number
WHATSAPP_URL=https://wa.me/256700000000
